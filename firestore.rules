rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection rules
    match /projects/{projectId} {
      // Allow read access to published projects for everyone
      allow read: if request.auth != null || resource.data.published == true;
      
      // Allow write access only to authenticated users
      allow write: if request.auth != null;
      
      // Allow create only for authenticated users with proper data validation
      allow create: if request.auth != null &&
        request.auth.token.email_verified == true &&
        request.resource.data.title is string &&
        request.resource.data.description is string &&
        request.resource.data.techStack is list &&
        request.resource.data.published is bool &&
        request.resource.data.createdAt is timestamp;
      
      // Allow update only for authenticated users who own the document
      allow update: if request.auth != null &&
        request.auth.token.email_verified == true &&
        resource.data.title is string &&
        resource.data.description is string &&
        resource.data.techStack is list &&
        resource.data.published is bool;
      
      // Allow delete only for authenticated users
      allow delete: if request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Experience collection rules
    match /experience/{experienceId} {
      // Allow read access only to authenticated users
      allow read: if request.auth != null;
      
      // Allow write access only to authenticated users
      allow write: if request.auth != null;
      
      // Allow create only for authenticated users with proper data validation
      allow create: if request.auth != null &&
        request.auth.token.email_verified == true &&
        request.resource.data.company is string &&
        request.resource.data.role is string &&
        request.resource.data.duration is string &&
        request.resource.data.description is list &&
        request.resource.data.startDate is timestamp;
      
      // Allow update only for authenticated users with proper validation
      allow update: if request.auth != null &&
        request.auth.token.email_verified == true &&
        resource.data.company is string &&
        resource.data.role is string &&
        resource.data.duration is string &&
        resource.data.description is list;
      
      // Allow delete only for authenticated users
      allow delete: if request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
